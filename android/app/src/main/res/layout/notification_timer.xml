<?xml version="1.0" encoding="utf-8"?>
<!-- The running-timer notification body: app icon, big ticking time, round buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <Chronometer
            android:id="@+id/timer_chrono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="#EE6B6E"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/timer_frozen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="#EE6B6E"
            android:textSize="26sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/timer_label"
            style="@style/TextAppearance.Compat.Notification.Info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btn_primary"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/btn_circle_soft"
        android:contentDescription="Pause or resume"
        android:padding="11dp"
        android:src="@drawable/ic_timer_pause" />

    <ImageView
        android:id="@+id/btn_stop"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/btn_circle_soft"
        android:contentDescription="Stop"
        android:padding="11dp"
        android:src="@drawable/ic_timer_close"
        android:visibility="gone" />
</LinearLayout>
