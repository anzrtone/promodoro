{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Promodoro",
  "version": "../package.json",
  "identifier": "app.promodoro.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Promodoro",
        "width": 1180,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#FDFBF7",
        "backgroundThrottling": "disabled",
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost https://*.workers.dev"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "deb", "dmg"],
    "category": "Productivity",
    "shortDescription": "A cozy, local-first focus timer",
    "longDescription": "Promodoro is a free, private focus timer with a tomato mascot named Pomo. Gentle Flow overtime, missed-time recovery, an honest history timeline, and all your data stays on your device.",
    "copyright": "© Promodoro",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false }
    }
  }
}
