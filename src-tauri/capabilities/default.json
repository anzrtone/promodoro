{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the Promodoro main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "notification:default",
    "dialog:allow-save",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/*" }, { "url": "https://discord.gg/*" }, { "url": "https://supportkori.com/*" }, { "url": "https://www.supportkori.com/*" }, { "url": "mailto:*" }]
    }
  ]
}
